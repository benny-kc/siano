<%!--
  The whole app is pinned to the viewport (`fixed inset-0`, `overflow-hidden`)
  so the page never scrolls — that is what used to fight the drag gesture.
  The board and the traveller dock are always on screen and ready to drag.
  Everything else (managing travellers, totals, settle-up, admin) lives in a
  drawer that slides in from the side when you tap the settings button.
--%>
<div class="fixed inset-0 flex flex-col overflow-hidden bg-slate-950" id="trip" phx-hook="Gestures">
  <%!-- ─────────── Top bar ─────────── --%>
  <header class="pt-safe flex shrink-0 flex-wrap items-center gap-2 px-4 pb-3">
    <div class="flex items-center gap-2 text-xl font-black tracking-tight">
      <span class="text-2xl">🧳</span>
      <span>Siano</span>
    </div>
    <div class="rounded-full bg-slate-800/70 px-3 py-1 text-xs">
      <span class="font-semibold text-slate-100"><%= @trip.name %></span>
    </div>

    <%!-- the running bill total doubles as the Bills-history button --%>
    <div class="ml-auto flex items-center gap-2">
      <button
        phx-click="open_drawer"
        phx-value-which="bills"
        class="flex flex-col items-center rounded-2xl bg-slate-800/70 px-3 py-1 leading-tight transition hover:bg-slate-700"
        title="Bills history"
      >
        <span class="text-xs">
          <span class="font-bold text-slate-100"><%= @trip.bill_count %></span>
          <span class="text-slate-400"><%= (@trip.bill_count == 1 && "bill") || "bills" %></span>
        </span>
        <span class="font-mono text-sm font-bold text-amber-300"><%= money(@trip.total_cents) %></span>
      </button>
      <button
        phx-click="add_meal"
        class="rounded-lg bg-amber-500 px-3 py-2 text-sm font-semibold text-slate-950 shadow transition hover:scale-105 hover:bg-amber-400 active:scale-95"
      >
        ➕ Meal
      </button>
      <button
        phx-click="open_drawer"
        phx-value-which="menu"
        class="rounded-lg bg-slate-800 px-3 py-2 text-sm font-semibold text-slate-200 transition hover:bg-slate-700"
        aria-label="Open settings"
      >
        ⚙️ Settings
      </button>
    </div>
  </header>

  <%!-- ─────────── The game board (meals) ─────────── --%>
  <main
    id="board-surface"
    class="board-surface relative isolate mx-2 min-h-0 flex-1 overflow-hidden rounded-2xl border border-slate-800"
  >
    <p
      :if={@trip.meals == []}
      class="pointer-events-none absolute inset-0 flex items-center justify-center px-8 text-center text-slate-500"
    >
      Drag a traveller up here to start a meal — or tap “➕ Meal”. Then drop the others onto it to split the bill 🍽️
    </p>

    <article
      :for={meal <- @trip.meals}
      id={"meal-#{meal.id}"}
      class="meal-card animate-pop absolute w-64 select-none rounded-2xl border border-slate-700 bg-slate-900/95 p-4 shadow-xl"
      style={"left: #{meal.x}px; top: #{meal.y}px;"}
      phx-hook="MealCard"
      data-meal-id={meal.id}
      data-x={meal.x}
      data-y={meal.y}
    >
      <div class="mb-2 flex items-center gap-2">
        <span class="drag-handle cursor-grab text-slate-500 active:cursor-grabbing" title="Drag to move">⠿</span>
        <span class="text-2xl"><%= meal.emoji %></span>
        <input
          type="text"
          value={meal.name}
          phx-blur="rename_meal"
          phx-value-meal_id={meal.id}
          onkeydown="if(event.key==='Enter'){event.preventDefault();this.blur()}"
          aria-label="Meal name"
          title="Tap to rename"
          class="-mx-1 min-w-0 flex-1 truncate rounded-md border border-transparent bg-transparent px-1 py-0.5 font-bold text-slate-100 outline-none transition hover:border-slate-700 focus:border-amber-400 focus:bg-slate-800"
        />
        <button
          phx-click="close_meal"
          phx-value-id={meal.id}
          class="ml-auto shrink-0 text-slate-500 transition hover:text-slate-200"
          title="Close card (kept in Bills history)"
        >
          ✕
        </button>
      </div>

      <div class="mb-3 flex items-center gap-1">
        <span class="text-slate-400">Total</span>
        <input
          type="text"
          inputmode="decimal"
          value={(meal.amount_cents > 0 && money(meal.amount_cents)) || ""}
          placeholder="0.00"
          phx-blur="set_amount"
          phx-value-meal_id={meal.id}
          class="w-24 rounded-md border border-slate-700 bg-slate-800 px-2 py-1 text-right font-mono text-slate-100 focus:border-amber-400 focus:outline-none"
        />
        <span
          :if={meal.per_head_cents > 0 and not meal.has_custom_shares}
          class="ml-auto rounded-md bg-slate-800 px-2 py-1 text-xs text-amber-300"
        >
          <%= money(meal.per_head_cents) %>/head
        </span>
        <span
          :if={meal.has_custom_shares}
          class="ml-auto rounded-md bg-slate-800 px-2 py-1 text-xs text-amber-300"
        >
          custom 📌
        </span>
      </div>

      <%!-- drop zone for travellers --%>
      <div class="dropzone min-h-[3.5rem] rounded-xl border-2 border-dashed border-slate-700 p-2 transition">
        <p :if={meal.participants == []} class="py-2 text-center text-xs text-slate-500">
          drop travellers here
        </p>
        <div class="flex flex-wrap gap-2">
          <div
            :for={p <- meal.participants}
            class="group animate-pop relative flex items-center gap-1 rounded-full py-0.5 pl-0.5 pr-2 text-sm font-semibold text-slate-950"
            style={"background-color: #{p.color};"}
            title={"#{p.name} · #{money(p.share_cents)}#{(p.is_payer && " · paid") || ""}"}
          >
            <button
              type="button"
              phx-click="set_payer"
              phx-value-meal_id={meal.id}
              phx-value-member_id={p.id}
              class={[
                "grid h-7 w-7 place-items-center rounded-full bg-slate-950/20 text-xs",
                p.is_payer && "ring-2 ring-slate-950"
              ]}
              title="Mark as payer"
            >
              <%= (p.is_payer && "💳") || p.initials %>
            </button>

            <%= if @editing_share == {meal.id, p.id} do %>
              <form
                phx-submit="save_share"
                phx-value-meal_id={meal.id}
                phx-value-member_id={p.id}
                class="flex items-center"
              >
                <input
                  type="text"
                  inputmode="decimal"
                  name="value"
                  value={(p.locked && money(p.share_cents)) || ""}
                  placeholder={money(p.share_cents)}
                  id={"share-#{meal.id}-#{p.id}"}
                  phx-hook="Focus"
                  phx-blur="save_share"
                  phx-value-meal_id={meal.id}
                  phx-value-member_id={p.id}
                  class="w-16 rounded-md border border-slate-900/40 bg-white/90 px-1.5 py-0.5 text-right font-mono text-xs text-slate-900 focus:outline-none"
                />
              </form>
            <% else %>
              <div
                id={"chip-#{meal.id}-#{p.id}"}
                phx-hook="LongPress"
                data-meal-id={meal.id}
                data-member-id={p.id}
                class="flex cursor-pointer select-none items-center gap-1"
                title="Hold to set an exact share"
              >
                <span class="max-w-[5rem] truncate"><%= p.name %></span>
                <span class="font-mono text-xs opacity-70"><%= money(p.share_cents) %></span>
                <span :if={p.locked} class="text-[10px]" title="Custom share">📌</span>
              </div>
            <% end %>

            <button
              type="button"
              phx-click="remove_participant"
              phx-value-meal_id={meal.id}
              phx-value-member_id={p.id}
              class="ml-0.5 hidden text-slate-950/60 hover:text-slate-950 group-hover:block"
              title="Remove from meal"
            >
              ✕
            </button>
          </div>
        </div>
      </div>

      <p :if={meal.participants != []} class="mt-2 text-[11px] text-slate-500">
        hold a name to set an exact share · 💳 marks who paid
      </p>
    </article>
  </main>

  <%!-- ─────────── Traveller dock (always ready to drag) ─────────── --%>
  <footer class="pb-safe shrink-0 px-3 pt-2">
    <div class="mb-1 flex items-center justify-between px-1">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Travellers</span>
      <span class="text-xs text-slate-600">drag onto a meal ↑</span>
    </div>
    <div class="dock flex max-h-[40vh] flex-wrap content-start justify-center gap-3 overflow-y-auto pb-1">
      <div
        :for={m <- @trip.members}
        id={"traveller-#{m.id}"}
        class="traveller-token animate-pop flex w-16 shrink-0 cursor-grab flex-col items-center gap-1 active:cursor-grabbing"
        phx-hook="Traveller"
        data-member-id={m.id}
      >
        <span
          class="grid h-12 w-12 place-items-center rounded-full text-base font-black text-slate-950 shadow-lg ring-2 ring-slate-950/30 transition hover:-translate-y-1"
          style={"background-color: #{m.color};"}
        >
          <%= m.initials %>
        </span>
        <span class="w-full truncate text-center text-xs font-semibold leading-tight"><%= m.name %></span>
      </div>

      <p :if={@trip.members == []} class="py-3 text-sm text-slate-500">
        No travellers yet — add some in ⚙️ Settings.
      </p>
    </div>
  </footer>

  <%!-- ─────────── Bills history (slides in from the left) ─────────── --%>
  <div
    id="bills-backdrop"
    phx-click="close_drawer"
    class={[
      "fixed inset-0 z-40 bg-black/60 backdrop-blur-sm transition-opacity duration-300",
      (@drawer == "bills" && "opacity-100") || "opacity-0 pointer-events-none"
    ]}
  >
  </div>

  <aside
    id="bills"
    phx-hook="DrawerWatch"
    class={[
      "pt-safe-lg pb-safe-lg fixed inset-y-0 left-0 z-50 w-full max-w-sm space-y-4 overflow-y-auto border-r border-slate-800 bg-slate-900 px-5 shadow-2xl transition-transform duration-300 ease-in-out",
      (@drawer == "bills" && "translate-x-0") || "-translate-x-full"
    ]}
  >
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-black">🧾 Bills</h2>
      <button
        phx-click="close_drawer"
        class="grid h-9 w-9 place-items-center rounded-full bg-slate-800 text-slate-300 transition hover:bg-slate-700"
        aria-label="Close bills"
      >
        ✕
      </button>
    </div>

    <p class="text-xs text-slate-500">Tap a bill to open it on the board and edit it.</p>

    <p
      :if={@trip.bills == []}
      class="rounded-xl bg-slate-800/40 p-3 text-sm text-slate-500"
    >
      No bills yet — tap “➕ Meal” to add one.
    </p>

    <ul class="space-y-2">
      <li :for={bill <- @trip.bills} class="flex items-stretch gap-2">
        <button
          phx-click="open_meal"
          phx-value-id={bill.id}
          class="flex flex-1 items-center gap-3 rounded-xl bg-slate-800/60 px-3 py-2 text-left transition hover:bg-slate-700"
        >
          <span class="text-2xl"><%= bill.emoji %></span>
          <span class="flex min-w-0 flex-1 flex-col leading-tight">
            <span class="truncate font-semibold"><%= bill.name %></span>
            <span class="truncate text-xs text-slate-400">
              <%= bill.participant_count %> <%= (bill.participant_count == 1 && "person") || "people" %><%= if bill.payer_name, do: " · #{bill.payer_name} paid" %><%= if not bill.complete, do: " · draft" %>
            </span>
          </span>
          <span class="flex shrink-0 flex-col items-end">
            <span class="font-mono font-bold text-amber-300"><%= money(bill.amount_cents) %></span>
            <span class={["text-[10px]", (bill.open && "text-emerald-400") || "text-slate-500"]}>
              <%= (bill.open && "on board") || "closed" %>
            </span>
          </span>
        </button>

        <button
          phx-click="delete_meal"
          phx-value-id={bill.id}
          data-confirm={"Delete “#{bill.name}” permanently? This removes its cost from everyone's balance."}
          class="grid w-11 shrink-0 place-items-center rounded-xl bg-slate-800/60 text-slate-500 transition hover:bg-rose-600/20 hover:text-rose-400"
          title="Delete bill"
          aria-label={"Delete #{bill.name}"}
        >
          🗑
        </button>
      </li>
    </ul>
  </aside>

  <%!-- ─────────── Settings drawer backdrop ─────────── --%>
  <div
    id="menu-backdrop"
    phx-click="close_drawer"
    class={[
      "fixed inset-0 z-40 bg-black/60 backdrop-blur-sm transition-opacity duration-300",
      (@drawer == "menu" && "opacity-100") || "opacity-0 pointer-events-none"
    ]}
  >
  </div>

  <%!-- ─────────── Slide-in settings drawer ─────────── --%>
  <aside
    id="menu"
    phx-hook="DrawerWatch"
    class={[
      "pt-safe-lg pb-safe-lg fixed inset-y-0 right-0 z-50 w-full max-w-sm space-y-5 overflow-y-auto border-l border-slate-800 bg-slate-900 px-5 shadow-2xl transition-transform duration-300 ease-in-out",
      (@drawer == "menu" && "translate-x-0") || "translate-x-full"
    ]}
  >
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-black">⚙️ Settings</h2>
      <button
        phx-click="close_drawer"
        class="grid h-9 w-9 place-items-center rounded-full bg-slate-800 text-slate-300 transition hover:bg-slate-700"
        aria-label="Close settings"
      >
        ✕
      </button>
    </div>

    <%!-- Manage travellers --%>
    <div>
      <h3 class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-400">Travellers</h3>
      <ul class="space-y-1.5">
        <li
          :for={m <- @trip.members}
          class="rounded-xl bg-slate-800/60 px-3 py-2"
        >
          <div class="flex items-center gap-2">
            <span
              class="grid h-8 w-8 shrink-0 place-items-center rounded-full text-sm font-black text-slate-950"
              style={"background-color: #{m.color};"}
            >
              <%= m.initials %>
            </span>
            <span class="min-w-0 flex-1 truncate text-sm font-semibold"><%= m.name %></span>
            <button
              phx-click="remove_member"
              phx-value-id={m.id}
              data-confirm={"Remove #{m.name} from the trip? Their meals and shares will be recalculated."}
              class="text-slate-500 transition hover:text-rose-400"
              title="Remove traveller"
            >
              ✕
            </button>
          </div>

          <form phx-change="set_budget" class="mt-2 flex items-center gap-2">
            <input type="hidden" name="member_id" value={m.id} />
            <span class="text-xs text-slate-500">💰 budget</span>
            <select
              name="target"
              class="min-w-0 flex-1 rounded-md border border-slate-700 bg-slate-800 px-2 py-1 text-xs text-slate-200 focus:border-amber-400 focus:outline-none"
            >
              <option value={m.id} selected={m.budget_id == m.id}>on their own</option>
              <option
                :for={o <- @trip.members}
                :if={o.id != m.id}
                value={o.id}
                selected={m.budget_id == o.id}
              >
                shared with <%= o.name %>
              </option>
            </select>
          </form>
        </li>
      </ul>

      <form phx-submit="add_member" class="mt-3 flex gap-2">
        <input
          type="text"
          name="name"
          value={@new_member}
          placeholder="Add traveller…"
          autocomplete="off"
          class="flex-1 rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm focus:border-amber-400 focus:outline-none"
        />
        <button class="rounded-lg bg-slate-700 px-3 py-2 text-sm font-semibold transition hover:bg-slate-600">
          Add
        </button>
      </form>
    </div>

    <%!-- Budgets (pooled balances) --%>
    <div>
      <h3 class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-400">
        Budgets <span class="text-slate-600">(who owes whom)</span>
      </h3>
      <ul class="space-y-1.5">
        <li
          :for={b <- @trip.budgets}
          class="flex items-center gap-2 rounded-xl bg-slate-800/60 px-3 py-2"
        >
          <span :if={b.size > 1} class="text-sm">👥</span>
          <span :if={b.size == 1} class="text-sm">🙂</span>
          <span class="flex min-w-0 flex-col leading-tight">
            <span class="truncate text-sm font-semibold"><%= b.name %></span>
            <span class={["text-xs", balance_tone(b.balance_cents)]}>
              <%= balance_label(b.balance_cents) %>
            </span>
          </span>
        </li>
      </ul>
    </div>

    <%!-- Total --%>
    <div class="rounded-xl bg-slate-800/60 p-4">
      <p class="text-xs uppercase tracking-wider text-slate-400">Total tracked</p>
      <p class="mt-1 text-3xl font-black text-amber-300"><%= money(@trip.total_cents) %></p>
      <p class="text-xs text-slate-500">
        <%= @trip.member_count %> travellers<%= if @trip.budget_count < @trip.member_count, do: " · #{@trip.budget_count} budgets" %>
      </p>
    </div>

    <%!-- Settle up --%>
    <div>
      <h3 class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-400">Settle up</h3>
      <p :if={@trip.settlements == []} class="rounded-xl bg-slate-800/40 p-3 text-sm text-slate-500">
        Everyone's even — nothing to settle 🎉
      </p>
      <ul class="space-y-1.5">
        <li
          :for={s <- @trip.settlements}
          class="flex items-center gap-2 rounded-xl bg-slate-800/60 px-3 py-2 text-sm"
        >
          <span class="font-semibold text-rose-300"><%= s.from %></span>
          <span class="text-slate-500">→</span>
          <span class="font-semibold text-emerald-300"><%= s.to %></span>
          <span class="ml-auto font-mono font-bold text-slate-100"><%= money(s.amount_cents) %></span>
        </li>
      </ul>
    </div>

    <%!-- Personal ledger (selection handled client-side so Settings stays open) --%>
    <div id="ledger" phx-hook="Ledger" data-trip-id={@trip_id}>
      <h3 class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-400">Your ledger</h3>
      <div class="mb-2 flex flex-wrap gap-1">
        <button
          :for={m <- @trip.members}
          type="button"
          data-member-id={m.id}
          class="ledger-pick rounded-full bg-slate-800 px-2.5 py-1 text-xs font-semibold text-slate-300 transition hover:bg-slate-700"
        >
          <%= m.name %>
        </button>
      </div>

      <div
        :for={m <- @trip.members}
        id={"ledger-#{m.id}"}
        data-member-id={m.id}
        class="ledger-block hidden rounded-xl bg-slate-800/60 p-4"
      >
        <p class="text-sm text-slate-300">
          Hi <span class="font-bold" style={"color: #{m.color}"}><%= m.name %></span> 👋
        </p>
        <p :if={m.budget_name != m.name} class="text-xs text-slate-400">
          budget: <span class="font-semibold">💰 <%= m.budget_name %></span>
        </p>
        <p class={["mt-1 text-2xl font-black", balance_tone(m.balance_cents)]}>
          <%= you_balance_label(m.balance_cents) %>
        </p>
        <ul class="mt-3 space-y-1 text-sm">
          <li
            :for={s <- Enum.filter(@trip.settlements, &(&1.from == m.budget_name))}
            class="flex justify-between text-rose-300"
          >
            <span>pay <%= s.to %></span>
            <span class="font-mono"><%= money(s.amount_cents) %></span>
          </li>
          <li
            :for={s <- Enum.filter(@trip.settlements, &(&1.to == m.budget_name))}
            class="flex justify-between text-emerald-300"
          >
            <span>collect from <%= s.from %></span>
            <span class="font-mono"><%= money(s.amount_cents) %></span>
          </li>
        </ul>
      </div>

      <p class="ledger-empty text-sm text-slate-500">
        Pick who you are to see a personal breakdown.
      </p>
    </div>

    <%!-- Rename trip --%>
    <div>
      <h3 class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-400">Trip name</h3>
      <input
        type="text"
        value={@trip.name}
        placeholder="Name this trip…"
        phx-blur="rename_trip"
        onkeydown="if(event.key==='Enter'){event.preventDefault();this.blur()}"
        aria-label="Trip name"
        class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-slate-100 focus:border-amber-400 focus:outline-none"
      />
      <p class="mt-1.5 text-xs text-slate-500">
        Trip ID: <span class="font-mono text-slate-400"><%= @trip_id %></span>
        <span class="text-slate-600">— share this to invite others</span>
      </p>

      <div class="mt-3 flex flex-col items-center gap-1.5">
        <div
          id="trip-qr"
          phx-hook="QR"
          phx-update="ignore"
          data-trip-id={@trip_id}
          class="rounded-lg bg-white p-2 shadow"
        >
        </div>
        <span class="text-xs text-slate-500">Scan to open this trip on another phone</span>
      </div>
    </div>

    <%!-- Admin --%>
    <div class="space-y-2 border-t border-slate-800 pt-4">
      <button
        phx-click="new_trip"
        class="w-full rounded-xl bg-slate-800 px-4 py-3 text-sm font-semibold text-slate-200 transition hover:bg-slate-700"
      >
        ✨ New trip
      </button>
      <button
        phx-click="restart_server"
        data-confirm="Restart the server now? Everyone will briefly disconnect while it reloads."
        class="w-full rounded-xl bg-rose-600 px-4 py-3 text-sm font-bold text-white shadow-lg transition hover:bg-rose-500 active:scale-95"
      >
        🔄 Pull &amp; restart server
      </button>
      <p class="text-center text-xs text-slate-500">
        Stops the BEAM (<code class="text-slate-400">:c.q</code>); your process manager
        <code class="text-slate-400">git pull</code>s &amp; relaunches it.
      </p>
    </div>
  </aside>
</div>
