<%!--
  The whole app is pinned to the viewport (`fixed inset-0`, `overflow-hidden`)
  so the page never scrolls — that is what used to fight the drag gesture.
  The board and the traveller dock are always on screen and ready to drag.
  Everything else (managing travellers, totals, settle-up, admin) lives in a
  drawer that slides in from the side when you tap the settings button.

  Each section below is a function component in `SianoWeb.TripLive.Components`
  (markup under `trip_live/sections/`). This file just composes them.
--%>
<div
  class="fixed inset-0 flex flex-col overflow-hidden bg-slate-950 landscape:flex-row"
  id="trip"
  phx-hook="Gestures"
>
  <Components.top_bar trip={@trip} trip_id={@trip_id} />
  <Components.board trip={@trip} trip_id={@trip_id} editing_share={@editing_share} />
  <Components.dock trip={@trip} />
  <Components.bills_drawer trip={@trip} drawer={@drawer} bills_filter={@bills_filter} />
  <Components.settings trip={@trip} trip_id={@trip_id} drawer={@drawer} new_member={@new_member} />
  <Components.help help={@help} />
  <Components.confirm />
</div>
