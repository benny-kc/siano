<%!--
  The whole app is pinned to the viewport (`fixed inset-0`, `overflow-hidden`)
  so the page never scrolls — that is what used to fight the drag gesture.
  The board and the traveller dock are always on screen and ready to drag.
  Everything else (managing travellers, totals, settle-up, admin) lives in a
  drawer that slides in from the side when you tap the settings button.
--%>
<div
  class="fixed inset-0 flex flex-col overflow-hidden bg-slate-950 landscape:flex-row"
  id="trip"
  phx-hook="Gestures"
>
  <%!-- ─────────── Top bar (a left column in landscape) ─────────── --%>
  <header class="pt-safe flex shrink-0 flex-wrap items-center gap-2 px-4 pb-3 text-slate-400 landscape:w-16 landscape:flex-col landscape:flex-nowrap landscape:items-center landscape:gap-2 landscape:px-1.5 landscape:pb-2">
    <%!-- title + trip name: secondary to the board, so kept muted --%>
    <div class="flex items-center gap-1.5 text-base font-bold tracking-tight landscape:flex-col landscape:gap-0.5">
      <span class="text-xl">🧳</span>
      <span class="landscape:hidden">Siano</span>
    </div>
    <div class="max-w-[40vw] truncate rounded-full bg-slate-800/50 px-2.5 py-0.5 text-xs landscape:w-full landscape:max-w-none landscape:text-center landscape:text-[11px]">
      <%= @trip.name %>
    </div>

    <div class="ml-auto flex items-center gap-2 landscape:ml-0 landscape:w-full landscape:flex-col landscape:gap-2">
      <%!-- running total (muted); tap the bills button below for the history --%>
      <span class="font-mono text-sm font-semibold text-amber-300/80 landscape:text-[11px]">
        <%= money(@trip.total_cents) %>
      </span>

      <%!-- Uniform icon buttons. All the same size/shape/icon style; Meal is
           amber to flag it as the primary "add" action. The whole row is
           deliberately muted — the board is the star. --%>
      <div class="flex items-center gap-1.5 landscape:flex-col landscape:gap-2">
        <button
          phx-click="open_drawer"
          phx-value-which="bills"
          class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-slate-800/60 text-slate-400 transition hover:bg-slate-700 hover:text-white"
          title="Bills history"
          aria-label="Bills history"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h10" />
          </svg>
        </button>

        <label
          class="grid h-9 w-9 shrink-0 cursor-pointer place-items-center rounded-xl bg-slate-800/60 text-slate-400 transition hover:bg-slate-700 hover:text-white"
          title="Add bill photo"
          aria-label="Add bill photo"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 8a2 2 0 012-2h1l1-2h6l1 2h1a2 2 0 012 2v8a2 2 0 01-2 2H6a2 2 0 01-2-2V8z"
            />
            <circle cx="12" cy="12" r="3.2" stroke-linecap="round" />
          </svg>
          <input
            type="file"
            accept="image/*"
            class="hidden"
            id="top-photo-input"
            phx-hook="TopPhoto"
            data-trip-id={@trip_id}
          />
        </label>

        <button
          phx-click="add_meal"
          class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-amber-500 text-slate-950 shadow transition hover:bg-amber-400 active:scale-95"
          title="Add meal"
          aria-label="Add meal"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-5 w-5">
            <path stroke-linecap="round" d="M12 5v14M5 12h14" />
          </svg>
        </button>

        <button
          phx-click="open_drawer"
          phx-value-which="menu"
          class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-slate-800/60 text-slate-400 transition hover:bg-slate-700 hover:text-white"
          title="Settings"
          aria-label="Open settings"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
            <circle cx="12" cy="12" r="3.2" />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19.4 15a1.6 1.6 0 00.3 1.8l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.6 1.6 0 00-1.8-.3 1.6 1.6 0 00-1 1.5V21a2 2 0 11-4 0v-.1a1.6 1.6 0 00-1-1.5 1.6 1.6 0 00-1.8.3l-.1.1a2 2 0 11-2.8-2.8l.1-.1a1.6 1.6 0 00.3-1.8 1.6 1.6 0 00-1.5-1H3a2 2 0 110-4h.1a1.6 1.6 0 001.5-1 1.6 1.6 0 00-.3-1.8l-.1-.1a2 2 0 112.8-2.8l.1.1a1.6 1.6 0 001.8.3H9a1.6 1.6 0 001-1.5V3a2 2 0 114 0v.1a1.6 1.6 0 001 1.5 1.6 1.6 0 001.8-.3l.1-.1a2 2 0 112.8 2.8l-.1.1a1.6 1.6 0 00-.3 1.8V9a1.6 1.6 0 001.5 1H21a2 2 0 110 4h-.1a1.6 1.6 0 00-1.5 1z"
            />
          </svg>
        </button>
      </div>
    </div>
  </header>

  <%!-- ─────────── The game board (meals) ─────────── --%>
  <main
    id="board-surface"
    phx-hook="PanZoom"
    class="board-surface relative isolate mx-2 min-h-0 min-w-0 flex-1 touch-none overflow-hidden rounded-2xl border border-slate-800"
  >
    <p
      :if={@trip.meals == []}
      class="pointer-events-none absolute inset-0 flex items-center justify-center px-8 text-center text-slate-500"
    >
      Drag a traveller up here to start a meal — or tap “➕ Meal”. Then drop the others onto it to split the bill 🍽️<br />
      <span class="mt-2 block text-xs text-slate-600">two fingers to pan · pinch to zoom</span>
    </p>

    <div id="board-canvas">
      <article
        :for={meal <- @trip.meals}
      id={"meal-#{meal.id}"}
      class="meal-card animate-pop absolute w-64 select-none rounded-2xl border border-slate-700 bg-slate-900/95 p-4 pb-2 shadow-xl"
      style={"left: #{meal.x}px; top: #{meal.y}px;"}
      phx-hook="MealCard"
      data-meal-id={meal.id}
      data-x={meal.x}
      data-y={meal.y}
    >
      <div class="mb-2 flex items-center gap-2">
        <span class="drag-handle cursor-grab text-slate-500 active:cursor-grabbing" title="Drag to move">⠿</span>
        <span class="drag-handle cursor-grab text-2xl active:cursor-grabbing" title="Drag to move"><%= meal.emoji %></span>
        <input
          type="search"
          value={meal.name}
          phx-blur="rename_meal"
          phx-value-meal_id={meal.id}
          onkeydown="if(event.key==='Enter'){event.preventDefault();this.blur()}"
          aria-label="Meal name"
          title="Tap to rename"
          enterkeyhint="done"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="words"
          spellcheck="false"
          data-lpignore="true"
          data-1p-ignore
          data-form-type="other"
          class="siano-num -mx-1 min-w-0 flex-1 truncate rounded-md border border-transparent bg-transparent px-1 py-0.5 font-bold text-slate-100 outline-none transition hover:border-slate-700 focus:border-amber-400 focus:bg-slate-800"
        />
        <button
          phx-click="close_meal"
          phx-value-id={meal.id}
          class="ml-auto shrink-0 text-slate-500 transition hover:text-slate-200"
          title="Close card (kept in Bills history)"
        >
          ✕
        </button>
      </div>

      <div class="mb-3 flex items-center gap-1">
        <span class="text-slate-400">Total</span>
        <input
          type="search"
          inputmode="decimal"
          value={(meal.amount_cents > 0 && money(meal.amount_cents)) || ""}
          placeholder="0.00"
          phx-blur="set_amount"
          phx-value-meal_id={meal.id}
          name="siano-amount"
          enterkeyhint="done"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          data-lpignore="true"
          data-1p-ignore
          data-form-type="other"
          class="siano-num w-24 rounded-md border border-slate-700 bg-slate-800 px-2 py-1 text-right font-mono text-slate-100 focus:border-amber-400 focus:outline-none"
        />
        <span
          :if={meal.per_head_cents > 0 and not meal.has_custom_shares}
          class="ml-auto rounded-md bg-slate-800 px-2 py-1 text-xs text-amber-300"
        >
          <%= money(meal.per_head_cents) %>/head
        </span>
        <span
          :if={meal.has_custom_shares}
          class="ml-auto rounded-md bg-slate-800 px-2 py-1 text-xs text-amber-300"
        >
          custom 📌
        </span>
      </div>

      <%!-- drop zone for travellers --%>
      <div class="dropzone min-h-[3.5rem] rounded-xl border-2 border-dashed border-slate-700 p-2 transition">
        <p :if={meal.participants == []} class="py-2 text-center text-xs text-slate-500">
          drop travellers here
        </p>
        <div class="flex flex-wrap gap-2">
          <div
            :for={p <- meal.participants}
            class="group animate-pop relative flex items-center gap-1 rounded-full py-0.5 pl-0.5 pr-2 text-sm font-semibold text-slate-950"
            style={"background-color: #{p.color};"}
            title={"#{p.name} · #{money(p.share_cents)}#{(p.is_payer && " · paid") || ""}"}
          >
            <button
              type="button"
              phx-click="set_payer"
              phx-value-meal_id={meal.id}
              phx-value-member_id={p.id}
              class={[
                "grid h-7 w-7 place-items-center rounded-full bg-slate-950/20 text-xs",
                p.is_payer && "ring-2 ring-slate-950"
              ]}
              title="Mark as payer"
            >
              <%= (p.is_payer && "💳") || p.initials %>
            </button>

            <%= if @editing_share == {meal.id, p.id} do %>
              <form
                phx-submit="save_share"
                phx-value-meal_id={meal.id}
                phx-value-member_id={p.id}
                class="flex items-center"
              >
                <input
                  type="search"
                  inputmode="decimal"
                  name="value"
                  value={(p.locked && money(p.share_cents)) || ""}
                  placeholder={money(p.share_cents)}
                  id={"share-#{meal.id}-#{p.id}"}
                  phx-hook="Focus"
                  phx-blur="save_share"
                  phx-value-meal_id={meal.id}
                  phx-value-member_id={p.id}
                  enterkeyhint="done"
                  autocomplete="off"
                  autocorrect="off"
                  autocapitalize="off"
                  spellcheck="false"
                  data-lpignore="true"
                  data-1p-ignore
                  data-form-type="other"
                  class="siano-num w-16 rounded-md border border-slate-900/40 bg-white/90 px-1.5 py-0.5 text-right font-mono text-xs text-slate-900 focus:outline-none"
                />
              </form>
            <% else %>
              <div
                id={"chip-#{meal.id}-#{p.id}"}
                phx-hook="LongPress"
                data-meal-id={meal.id}
                data-member-id={p.id}
                class="flex cursor-pointer select-none items-center gap-1"
                title="Hold to set an exact share"
              >
                <span class="max-w-[5rem] truncate"><%= p.name %></span>
                <span class="font-mono text-xs opacity-70"><%= money(p.share_cents) %></span>
                <span :if={p.locked} class="text-[10px]" title="Custom share">📌</span>
              </div>
            <% end %>

            <button
              type="button"
              phx-click="remove_participant"
              phx-value-meal_id={meal.id}
              phx-value-member_id={p.id}
              class="ml-0.5 hidden text-slate-950/60 hover:text-slate-950 group-hover:block"
              title="Remove from meal"
            >
              ✕
            </button>
          </div>
        </div>
      </div>

      <p :if={meal.participants != []} class="mt-2 text-[11px] text-slate-500">
        hold a name to set an exact share · 💳 marks who paid
      </p>

      <div class="relative mt-1 flex min-h-6 items-center">
        <%!-- date (bottom-left) --%>
        <span
          :if={meal.inserted_at}
          id={"time-#{meal.id}"}
          phx-hook="LocalTime"
          data-ts={meal.inserted_at}
          class="text-[10px] text-slate-600"
        >
        </span>

        <%!-- add a bill photo (rescaled + uploaded client-side) — sits ~60%
             across the card width --%>
        <label
          class="absolute left-[60%] top-1/2 -translate-x-1/2 -translate-y-1/2 cursor-pointer text-slate-700 transition hover:text-amber-300"
          title="Add photo"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 8a2 2 0 012-2h1l1-2h6l1 2h1a2 2 0 012 2v8a2 2 0 01-2 2H6a2 2 0 01-2-2V8z"
            />
            <circle cx="12" cy="12" r="3.2" stroke-linecap="round" />
          </svg>
          <input
            type="file"
            accept="image/*"
            class="hidden"
            id={"photo-input-#{meal.id}"}
            phx-hook="PhotoUpload"
            data-meal-id={meal.id}
            data-trip-id={@trip_id}
          />
        </label>

        <%!-- delete (bottom-right) --%>
        <button
          type="button"
          data-confirm-event="delete_meal"
          data-confirm-payload={Jason.encode!(%{id: meal.id})}
          data-confirm-message={"Delete “#{meal.name}” permanently? This removes its cost from everyone's balance."}
          class="ml-auto text-slate-700 transition hover:text-rose-400"
          title="Delete bill"
          aria-label={"Delete #{meal.name}"}
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-[1.31rem] w-[1.31rem]">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 7h16M9 7V5a1 1 0 011-1h4a1 1 0 011 1v2m2 0v12a1 1 0 01-1 1H7a1 1 0 01-1-1V7"
            />
          </svg>
        </button>
      </div>

      <%!-- photo windows: sit to the left of the card and move / open / close
           with it. Recognised price fields are drawn as clickable overlays. --%>
      <div class="absolute top-0 w-96 space-y-2" style="right: calc(100% + 10px);">
        <div
          :for={photo <- meal.photos}
          class="photo-window animate-pop relative rounded-2xl border border-slate-700 bg-slate-900 p-1.5 shadow-xl"
        >
          <div
            id={"photo-#{photo.id}"}
            phx-hook="BillPhoto"
            data-trip-id={@trip_id}
            data-meal-id={meal.id}
            data-photo-id={photo.id}
            class="relative overflow-hidden rounded-xl"
          >
            <img src={photo.url} alt="bill photo" draggable="false" class="bill-img block w-full" />
            <%!-- connector lines (border <-> label) are drawn here by the
                 FieldLabel hook; phx-update=ignore keeps LiveView re-renders
                 from pruning those client-added <line> nodes. --%>
            <svg
              id={"connectors-#{photo.id}"}
              phx-update="ignore"
              class="field-connectors pointer-events-none absolute inset-0 h-full w-full"
              style="overflow: visible; z-index: 15;"
            >
            </svg>
            <button
              :for={{f, fi} <- Enum.with_index(photo.fields)}
              type="button"
              data-photo-id={photo.id}
              data-index={fi}
              class={[
                "field-overlay absolute z-10 rounded border-2 transition",
                (is_nil(f.member_id) && "border-amber-400/30 hover:bg-amber-300/10") || ""
              ]}
              style={
                "left: #{f.x * 100}%; top: #{f.y * 100}%; width: #{f.w * 100}%; height: #{f.h * 100}%;" <>
                  if(f.member_id, do: " border-color: #{f.color}4D; background-color: #{f.color}33;", else: "")
              }
              title={f.text}
              aria-label={"Price #{f.text}"}
            >
            </button>
            <%!-- the recognised text, printed to the side of each field (never
                 over it) so it can be compared against the original image. Drag
                 a label to move it out of the way. --%>
            <span
              :for={{f, fi} <- Enum.with_index(photo.fields)}
              id={"flabel-#{photo.id}-#{fi}"}
              phx-hook="FieldLabel"
              data-key={"#{photo.id}:#{fi}"}
              data-photo-id={photo.id}
              data-index={fi}
              inputmode="decimal"
              enterkeyhint="done"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              data-lpignore="true"
              data-1p-ignore
              data-form-type="other"
              class="field-label absolute z-20 cursor-move touch-none select-none whitespace-nowrap rounded bg-slate-900/90 px-1 text-[10px] font-bold leading-tight shadow"
              style={field_label_style(f)}
            >
              <%= f.text %>
            </span>
          </div>
          <button
            type="button"
            data-confirm-event="remove_photo"
            data-confirm-payload={Jason.encode!(%{meal_id: meal.id, photo_id: photo.id})}
            data-confirm-message="Remove this photo?"
            class="absolute -right-2 -top-2 grid h-6 w-6 place-items-center rounded-full bg-slate-800 text-xs text-slate-300 shadow transition hover:text-rose-400"
            aria-label="Remove photo"
          >
            ✕
          </button>
        </div>
        <%!-- while a photo is being processed/uploaded the client drops a
             spinner placeholder in here; phx-update=ignore keeps it safe from
             re-renders. Empty (invisible) otherwise. --%>
        <div id={"photo-ph-#{meal.id}"} phx-update="ignore" class="photo-ph-slot"></div>
      </div>
      </article>
    </div>
  </main>

  <%!-- ─────────── Traveller dock (always ready to drag) ─────────── --%>
  <footer class="pb-safe flex shrink-0 flex-col px-3 pt-2 landscape:w-auto landscape:px-1 landscape:pt-3">
    <div class="mb-1 flex select-none items-center justify-between px-1 landscape:justify-center">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Travellers</span>
      <span class="text-xs text-slate-600 landscape:hidden">drag onto a meal ↑</span>
    </div>
    <%!-- Portrait: wraps into rows at the bottom. Landscape: fills the column
         height then wraps into more columns — never a scrollbar (the tokens are
         draggable, so a scroll region would fight the gesture). --%>
    <div class={[
      "dock flex max-h-[40vh] flex-wrap content-start justify-center overflow-y-auto pb-1",
      "landscape:min-h-0 landscape:max-h-none landscape:flex-1 landscape:flex-col landscape:content-start landscape:justify-start landscape:overflow-visible",
      (@trip.member_count > 6 && "gap-x-1 gap-y-2") || "gap-x-2 gap-y-2"
    ]}>
      <div
        :for={m <- @trip.members}
        id={"traveller-#{m.id}"}
        class="traveller-token animate-pop flex w-14 shrink-0 cursor-grab flex-col items-center gap-0.5 active:cursor-grabbing landscape:w-auto"
        phx-hook="Traveller"
        data-member-id={m.id}
      >
        <span
          class="avatar grid h-12 w-12 place-items-center rounded-full text-base font-black text-slate-950 shadow-lg ring-2 ring-slate-950/30 transition hover:-translate-y-1"
          style={"background-color: #{m.color};"}
        >
          <%= m.initials %>
        </span>
        <span class="w-full truncate text-center text-xs font-semibold leading-tight landscape:hidden">
          <%= m.name %>
        </span>
      </div>

      <p :if={@trip.members == []} class="py-3 text-sm text-slate-500">
        No travellers yet — add some in ⚙️ Settings.
      </p>
    </div>
  </footer>

  <%!-- ─────────── Bills history (slides in from the left) ─────────── --%>
  <div
    id="bills-backdrop"
    phx-click="close_drawer"
    class={[
      "fixed inset-0 z-40 bg-black/60 backdrop-blur-sm transition-opacity duration-300",
      (@drawer == "bills" && "opacity-100") || "opacity-0 pointer-events-none"
    ]}
  >
  </div>

  <aside
    id="bills"
    phx-hook="DrawerWatch"
    class={[
      "pt-safe-lg pb-safe-lg fixed inset-y-0 left-0 z-50 w-full max-w-sm space-y-4 overflow-y-auto border-r border-slate-800 bg-slate-900 px-5 shadow-2xl transition-transform duration-300 ease-in-out",
      (@drawer == "bills" && "translate-x-0") || "-translate-x-full"
    ]}
  >
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-black">🧾 Bills</h2>
      <button
        phx-click="close_drawer"
        class="grid h-9 w-9 place-items-center rounded-full bg-slate-800 text-slate-300 transition hover:bg-slate-700"
        aria-label="Close bills"
      >
        ✕
      </button>
    </div>

    <p class="text-xs text-slate-500">Tap a bill to open it on the board and edit it.</p>

    <p
      :if={@trip.bills == []}
      class="rounded-xl bg-slate-800/40 p-3 text-sm text-slate-500"
    >
      No bills yet — tap “➕ Meal” to add one.
    </p>

    <ul class="space-y-2">
      <li :for={bill <- @trip.bills} class="flex items-stretch gap-2">
        <button
          phx-click="open_meal"
          phx-value-id={bill.id}
          class="flex flex-1 items-center gap-3 rounded-xl bg-slate-800/60 px-3 py-2 text-left transition hover:bg-slate-700"
        >
          <span class="text-2xl"><%= bill.emoji %></span>
          <span class="flex min-w-0 flex-1 flex-col leading-tight">
            <span class="truncate font-semibold"><%= bill.name %></span>
            <span class="truncate text-xs text-slate-400">
              <%= bill.participant_count %> <%= (bill.participant_count == 1 && "person") || "people" %><%= if bill.payer_name, do: " · #{bill.payer_name} paid" %><%= if bill.photo_count > 0, do: " · 📷 #{bill.photo_count}" %><%= if not bill.complete, do: " · draft" %>
            </span>
          </span>
          <span class="flex shrink-0 flex-col items-end">
            <span class="font-mono font-bold text-amber-300"><%= money(bill.amount_cents) %></span>
            <span class={["text-[10px]", (bill.open && "text-emerald-400") || "text-slate-500"]}>
              <%= (bill.open && "on board") || "closed" %>
            </span>
          </span>
        </button>

        <button
          type="button"
          data-confirm-event="delete_meal"
          data-confirm-payload={Jason.encode!(%{id: bill.id})}
          data-confirm-message={"Delete “#{bill.name}” permanently? This removes its cost from everyone's balance."}
          class="grid w-11 shrink-0 place-items-center rounded-xl bg-slate-800/60 text-slate-500 transition hover:bg-rose-600/20 hover:text-rose-400"
          title="Delete bill"
          aria-label={"Delete #{bill.name}"}
        >
          🗑
        </button>
      </li>
    </ul>
  </aside>

  <%!-- ─────────── Settings drawer backdrop ─────────── --%>
  <div
    id="menu-backdrop"
    phx-click="close_drawer"
    class={[
      "fixed inset-0 z-40 bg-black/60 backdrop-blur-sm transition-opacity duration-300",
      (@drawer == "menu" && "opacity-100") || "opacity-0 pointer-events-none"
    ]}
  >
  </div>

  <%!-- ─────────── Slide-in settings drawer ─────────── --%>
  <aside
    id="menu"
    phx-hook="DrawerWatch"
    class={[
      "pt-safe-lg pb-safe-lg fixed inset-y-0 right-0 z-50 w-full max-w-sm space-y-5 overflow-y-auto border-l border-slate-800 bg-slate-900 px-5 shadow-2xl transition-transform duration-300 ease-in-out",
      (@drawer == "menu" && "translate-x-0") || "translate-x-full"
    ]}
  >
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-black">⚙️ Settings</h2>
      <button
        phx-click="close_drawer"
        class="grid h-9 w-9 place-items-center rounded-full bg-slate-800 text-slate-300 transition hover:bg-slate-700"
        aria-label="Close settings"
      >
        ✕
      </button>
    </div>

    <%!-- Manage travellers --%>
    <div>
      <h3 class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-400">Travellers</h3>
      <ul class="space-y-1.5">
        <li
          :for={m <- @trip.members}
          class="rounded-xl bg-slate-800/60 px-3 py-2"
        >
          <div class="flex items-center gap-2">
            <span
              class="grid h-8 w-8 shrink-0 place-items-center rounded-full text-sm font-black text-slate-950"
              style={"background-color: #{m.color};"}
            >
              <%= m.initials %>
            </span>
            <span class="min-w-0 flex-1 truncate text-sm font-semibold"><%= m.name %></span>
            <button
              type="button"
              data-confirm-event="remove_member"
              data-confirm-payload={Jason.encode!(%{id: m.id})}
              data-confirm-message={"Remove #{m.name} from the trip? Their meals and shares will be recalculated."}
              class="text-slate-500 transition hover:text-rose-400"
              title="Remove traveller"
            >
              ✕
            </button>
          </div>

          <form phx-change="set_budget" class="mt-2 flex items-center gap-2">
            <input type="hidden" name="member_id" value={m.id} />
            <span class="text-xs text-slate-500">💰 budget</span>
            <select
              name="target"
              class="min-w-0 flex-1 rounded-md border border-slate-700 bg-slate-800 px-2 py-1 text-xs text-slate-200 focus:border-amber-400 focus:outline-none"
            >
              <option value={m.id} selected={m.budget_solo}>on their own</option>
              <option
                :for={o <- @trip.members}
                :if={o.id != m.id}
                value={o.id}
                selected={not m.budget_solo and o.id == m.budget_partner_id}
              >
                shared with <%= o.name %>
              </option>
            </select>
          </form>
          <%!-- the full pooled group, so it is always clear who shares with whom
               (the select can only point at one partner). --%>
          <p :if={not m.budget_solo} class="mt-1 pl-1 text-[11px] text-amber-300/80">
            💰 shared budget: <%= m.budget_name %>
          </p>
        </li>
      </ul>

      <form phx-submit="add_member" class="mt-3 flex gap-2">
        <input
          type="search"
          name="name"
          value={@new_member}
          placeholder="Add traveller…"
          enterkeyhint="done"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="words"
          spellcheck="false"
          data-lpignore="true"
          data-1p-ignore
          data-form-type="other"
          class="siano-num flex-1 rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm focus:border-amber-400 focus:outline-none"
        />
        <button class="rounded-lg bg-slate-700 px-3 py-2 text-sm font-semibold transition hover:bg-slate-600">
          Add
        </button>
      </form>
    </div>

    <%!-- Budgets (pooled balances) --%>
    <div>
      <h3 class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-400">
        Budgets <span class="text-slate-600">(who owes whom)</span>
      </h3>
      <ul class="space-y-1.5">
        <li
          :for={b <- @trip.budgets}
          class="flex items-center gap-2 rounded-xl bg-slate-800/60 px-3 py-2"
        >
          <span :if={b.size > 1} class="text-sm">👥</span>
          <span :if={b.size == 1} class="text-sm">🙂</span>
          <span class="flex min-w-0 flex-col leading-tight">
            <span class="truncate text-sm font-semibold"><%= b.name %></span>
            <span class={["text-xs", balance_tone(b.balance_cents)]}>
              <%= balance_label(b.balance_cents) %>
            </span>
          </span>
        </li>
      </ul>
    </div>

    <%!-- Total --%>
    <div class="rounded-xl bg-slate-800/60 p-4">
      <p class="text-xs uppercase tracking-wider text-slate-400">Total tracked</p>
      <p class="mt-1 text-3xl font-black text-amber-300"><%= money(@trip.total_cents) %></p>
      <p class="text-xs text-slate-500">
        <%= @trip.member_count %> travellers<%= if @trip.budget_count < @trip.member_count, do: " · #{@trip.budget_count} budgets" %>
      </p>
    </div>

    <%!-- Settle up --%>
    <div>
      <h3 class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-400">Settle up</h3>
      <p :if={@trip.settlements == []} class="rounded-xl bg-slate-800/40 p-3 text-sm text-slate-500">
        Everyone's even — nothing to settle 🎉
      </p>
      <ul class="space-y-1.5">
        <li
          :for={s <- @trip.settlements}
          class="flex items-center gap-2 rounded-xl bg-slate-800/60 px-3 py-2 text-sm"
        >
          <span class="font-semibold text-rose-300"><%= s.from %></span>
          <span class="text-slate-500">→</span>
          <span class="font-semibold text-emerald-300"><%= s.to %></span>
          <span class="ml-auto font-mono font-bold text-slate-100"><%= money(s.amount_cents) %></span>
        </li>
      </ul>
    </div>

    <%!-- Personal ledger (selection handled client-side so Settings stays open) --%>
    <div id="ledger" phx-hook="Ledger" data-trip-id={@trip_id}>
      <h3 class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-400">Your ledger</h3>
      <div class="mb-2 flex flex-wrap gap-1">
        <button
          :for={m <- @trip.members}
          type="button"
          data-member-id={m.id}
          class="ledger-pick rounded-full bg-slate-800 px-2.5 py-1 text-xs font-semibold text-slate-300 transition hover:bg-slate-700"
        >
          <%= m.name %>
        </button>
      </div>

      <div
        :for={m <- @trip.members}
        id={"ledger-#{m.id}"}
        data-member-id={m.id}
        class="ledger-block hidden rounded-xl bg-slate-800/60 p-4"
      >
        <p class="text-sm text-slate-300">
          Hi <span class="font-bold" style={"color: #{m.color}"}><%= m.name %></span> 👋
        </p>
        <p :if={m.budget_name != m.name} class="text-xs text-slate-400">
          budget: <span class="font-semibold">💰 <%= m.budget_name %></span>
        </p>
        <p class={["mt-1 text-2xl font-black", balance_tone(m.balance_cents)]}>
          <%= you_balance_label(m.balance_cents) %>
        </p>
        <ul class="mt-3 space-y-1 text-sm">
          <li
            :for={s <- Enum.filter(@trip.settlements, &(&1.from == m.budget_name))}
            class="flex justify-between text-rose-300"
          >
            <span>pay <%= s.to %></span>
            <span class="font-mono"><%= money(s.amount_cents) %></span>
          </li>
          <li
            :for={s <- Enum.filter(@trip.settlements, &(&1.to == m.budget_name))}
            class="flex justify-between text-emerald-300"
          >
            <span>collect from <%= s.from %></span>
            <span class="font-mono"><%= money(s.amount_cents) %></span>
          </li>
        </ul>
      </div>

      <p class="ledger-empty text-sm text-slate-500">
        Pick who you are to see a personal breakdown.
      </p>
    </div>

    <%!-- Rename trip --%>
    <div>
      <h3 class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-400">Trip name</h3>
      <input
        type="search"
        value={@trip.name}
        placeholder="Name this trip…"
        phx-blur="rename_trip"
        onkeydown="if(event.key==='Enter'){event.preventDefault();this.blur()}"
        aria-label="Trip name"
        enterkeyhint="done"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="words"
        spellcheck="false"
        data-lpignore="true"
        data-1p-ignore
        data-form-type="other"
        class="siano-num w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-slate-100 focus:border-amber-400 focus:outline-none"
      />
      <p class="mt-1.5 text-xs text-slate-500">
        Trip ID: <span class="font-mono text-slate-400"><%= @trip_id %></span>
        <span class="text-slate-600">— share this to invite others</span>
      </p>

      <div class="mt-3 flex flex-col items-center gap-1.5">
        <div
          id="trip-qr"
          phx-hook="QR"
          phx-update="ignore"
          data-trip-id={@trip_id}
          class="rounded-lg bg-white p-2 shadow"
        >
        </div>
        <span class="text-xs text-slate-500">Scan to open this trip on another phone</span>
      </div>
    </div>

    <%!-- Trips this user follows on this device (localStorage) --%>
    <div id="trip-switcher" phx-hook="TripSwitcher" data-trip-id={@trip_id} data-trip-name={@trip.name}>
      <h3 class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-400">Your trips</h3>
      <ul class="trip-list space-y-1.5"></ul>
    </div>

    <%!-- Admin --%>
    <div class="space-y-2 border-t border-slate-800 pt-4">
      <button
        id="new-trip-btn"
        type="button"
        class="w-full rounded-xl bg-slate-800 px-4 py-3 text-sm font-semibold text-slate-200 transition hover:bg-slate-700"
      >
        ✨ New trip
      </button>
      <button
        type="button"
        data-confirm-event="restart_server"
        data-confirm-payload="{}"
        data-confirm-message="Restart the server now? Everyone will briefly disconnect while it reloads."
        class="w-full rounded-xl bg-rose-600 px-4 py-3 text-sm font-bold text-white shadow-lg transition hover:bg-rose-500 active:scale-95"
      >
        🔄 Pull &amp; restart server
      </button>
      <p class="text-center text-xs text-slate-500">
        Stops the BEAM (<code class="text-slate-400">:c.q</code>); your process manager
        <code class="text-slate-400">git pull</code>s &amp; relaunches it.
      </p>
    </div>

    <%!-- Help --%>
    <button
      type="button"
      phx-click="open_help"
      class="flex w-full items-center justify-center gap-2 rounded-xl bg-slate-800 px-4 py-3 text-sm font-semibold text-slate-200 transition hover:bg-slate-700"
    >
      ❓ How to use Siano
    </button>

    <%!-- Disclaimer --%>
    <div class="select-none border-t border-slate-800 pt-4 text-[11px] leading-relaxed text-slate-600">
      <p class="mb-1 font-semibold uppercase tracking-wider text-slate-500">Disclaimer</p>
      <p>
        Siano is provided for informational and convenience purposes only, with no
        warranty of any kind. It may contain bugs and can make mistakes in its
        calculations, splitting and tracking, so figures shown here are estimates —
        not a financial record. Always verify amounts yourselves before settling up.
        The author accepts no responsibility or liability for any errors, losses or
        disputes arising from use of this application. By using it you agree you do
        so at your own risk.
      </p>
    </div>
  </aside>

  <%!-- Help / how-to. Server-tracked (@help) so a live update from another
       viewer can't snap it shut mid-read. Short, scannable tips. --%>
  <div
    id="help-modal"
    class={[
      "fixed inset-0 z-[65] flex items-center justify-center p-6 transition-opacity duration-200",
      (@help && "opacity-100") || "pointer-events-none hidden opacity-0"
    ]}
  >
    <div phx-click="close_help" class="absolute inset-0 bg-black/60 backdrop-blur-md"></div>
    <div class="relative flex max-h-[78vh] w-full max-w-sm flex-col overflow-hidden rounded-2xl border border-slate-700 bg-slate-900 shadow-2xl">
      <div class="flex shrink-0 items-center justify-between border-b border-slate-800 px-4 py-3">
        <h2 class="text-base font-black tracking-tight">❓ How to use Siano</h2>
        <button
          type="button"
          phx-click="close_help"
          class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-slate-800 text-slate-300 transition hover:text-white"
          aria-label="Close help"
        >
          ✕
        </button>
      </div>

      <div class="space-y-5 overflow-y-auto px-4 py-4 text-sm leading-relaxed text-slate-300">
        <p class="text-slate-400">
          Siano splits a group trip's bills. Everyone who opens the trip's link sees the
          <b class="text-slate-200">same live board</b> — share it from ⚙️ Settings (link + QR).
        </p>

        <section>
          <h3 class="mb-1.5 font-bold text-amber-300">🧑‍🤝‍🧑 Travellers</h3>
          <ul class="list-disc space-y-1 pl-5 marker:text-slate-600">
            <li>Add or remove travellers in <b class="text-slate-200">⚙️ Settings</b>.</li>
            <li><b class="text-slate-200">Drag</b> a traveller onto a meal card to add them to that bill.</li>
            <li>Drag one onto <b class="text-slate-200">empty board space</b> to start a new meal with them.</li>
            <li>They sit along the bottom (portrait) or down the right side (landscape).</li>
          </ul>
        </section>

        <section>
          <h3 class="mb-1.5 font-bold text-amber-300">🍽️ Meals &amp; bills</h3>
          <ul class="list-disc space-y-1 pl-5 marker:text-slate-600">
            <li>Add a card with <b class="text-slate-200">➕ Meal</b> (top), or by dropping a traveller on empty space.</li>
            <li><b class="text-slate-200">Move</b> a card by dragging the <b class="text-slate-200">⠿ grip</b> or its emoji.</li>
            <li><b class="text-slate-200">Rename</b>: tap the title and type. <b class="text-slate-200">Total</b>: tap the amount and type.</li>
            <li><b class="text-slate-200">Who paid</b>: tap a person's round chip → 💳 marks the payer.</li>
            <li><b class="text-slate-200">Exact share</b>: press &amp; hold a person's name to type their amount (📌 = custom).</li>
            <li><b class="text-slate-200">✕ Close</b> hides the card but keeps the bill in history. <b class="text-slate-200">🗑 Delete</b> removes it and its cost.</li>
          </ul>
        </section>

        <section>
          <h3 class="mb-1.5 font-bold text-amber-300">🖐️ Moving the board</h3>
          <ul class="list-disc space-y-1 pl-5 marker:text-slate-600">
            <li><b class="text-slate-200">One finger</b> on empty space (or a card's blank body) drags the board.</li>
            <li><b class="text-slate-200">Two fingers</b> pan; <b class="text-slate-200">pinch</b> to zoom.</li>
            <li>Rotate your phone — whatever was centred stays centred.</li>
          </ul>
        </section>

        <section>
          <h3 class="mb-1.5 font-bold text-amber-300">📷 Bill photos</h3>
          <ul class="list-disc space-y-1 pl-5 marker:text-slate-600">
            <li>Add a photo with the <b class="text-slate-200">📷</b> in a card's bottom row, or the <b class="text-slate-200">📷 in the top bar</b> (goes to the meal you last used, or a new one).</li>
            <li>Photos are auto-straightened and prices are recognised automatically.</li>
            <li>Recognised prices show a <b class="text-slate-200">bordered box</b> with a number label beside it.</li>
            <li><b class="text-slate-200">Assign a price</b>: tap a traveller to select them, then tap the price boxes/labels — their share becomes the sum.</li>
            <li><b class="text-slate-200">Fix a wrong number</b>: with nobody selected, tap its label and edit it.</li>
            <li><b class="text-slate-200">Missed a price?</b> Long-press an empty spot on the photo to scan it; long-press an existing box to re-read it.</li>
          </ul>
        </section>

        <section>
          <h3 class="mb-1.5 font-bold text-amber-300">💰 Shared budgets</h3>
          <ul class="list-disc space-y-1 pl-5 marker:text-slate-600">
            <li>In Settings, set a traveller to <b class="text-slate-200">“shared with …”</b> to pool money (e.g. a couple).</li>
            <li>Meals still split <b class="text-slate-200">per person</b>, but who owes whom is settled <b class="text-slate-200">per budget</b>.</li>
          </ul>
        </section>

        <section>
          <h3 class="mb-1.5 font-bold text-amber-300">📂 Drawers</h3>
          <ul class="list-disc space-y-1 pl-5 marker:text-slate-600">
            <li><b class="text-slate-200">Bills history</b>: the ☰ button (top-left), or swipe in from the <b class="text-slate-200">left edge</b>. Tap a bill to bring it back onto the board.</li>
            <li><b class="text-slate-200">Settings</b>: the ⚙️ button (top-right), or swipe in from the <b class="text-slate-200">right edge</b>.</li>
            <li>The phone's <b class="text-slate-200">Back</b> button closes an open drawer.</li>
          </ul>
        </section>

        <section>
          <h3 class="mb-1.5 font-bold text-amber-300">🧳 Trips &amp; sharing</h3>
          <ul class="list-disc space-y-1 pl-5 marker:text-slate-600">
            <li><b class="text-slate-200">✨ New trip</b> (Settings) starts a fresh board.</li>
            <li>Every trip you open is remembered under <b class="text-slate-200">“Your trips”</b> — tap one to switch.</li>
            <li>Share a trip with the <b class="text-slate-200">link + QR code</b> in Settings.</li>
            <li><b class="text-slate-200">Your ledger</b>: in Settings, pick who you are to see your own balance and who to pay.</li>
          </ul>
        </section>

        <p class="border-t border-slate-800 pt-3 text-xs text-slate-500">
          Tip: everything here is also learnable by tapping around — nothing is destructive
          without a confirmation. Come back any time via ⚙️ Settings → ❓.
        </p>
      </div>
    </div>
  </div>

  <%!-- In-page confirmation dialog (replaces the native confirm() so the app
       never drops out of full-screen). --%>
  <div
    id="confirm-modal"
    phx-hook="Confirm"
    class="hidden fixed inset-0 z-[70] flex items-center justify-center p-6 opacity-0 transition-opacity duration-200"
  >
    <div class="confirm-backdrop absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
    <div class="relative w-full max-w-xs rounded-2xl border border-slate-700 bg-slate-900 p-5 shadow-2xl">
      <p class="confirm-message text-sm leading-relaxed text-slate-200"></p>
      <div class="mt-5 flex justify-end gap-2">
        <button
          type="button"
          class="confirm-no rounded-lg bg-slate-800 px-4 py-2 text-sm font-semibold text-slate-200 transition hover:bg-slate-700"
        >
          No
        </button>
        <button
          type="button"
          class="confirm-yes rounded-lg bg-rose-600 px-4 py-2 text-sm font-bold text-white transition hover:bg-rose-500"
        >
          Yes
        </button>
      </div>
    </div>
  </div>
</div>
