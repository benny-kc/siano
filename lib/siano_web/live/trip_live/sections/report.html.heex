  <%!-- Report drawer. A read-only, spreadsheet-style view of the whole trip —
       every bill, each traveller's share, who paid, the running totals and the
       suggested settlements — so the math can be eyeballed at a glance, plus a
       "Download CSV" button that saves the same data as a file (a backup / a way
       to verify it in a real spreadsheet).

       It's a *second* left drawer that slides in over the Bills drawer: opened by
       the report button in Bills, or by another left-edge swipe while Bills is
       open; closing it (✕ / backdrop / swipe-left / Back) returns to the board.
       Like the other drawers its open/closed state is client-side
       (:root[data-siano-report], slid by CSS in app.css) so opening it is instant
       and a live update from another viewer can't snap it shut mid-read —
       morphdom never touches :root. Everything renders from @trip.report, which the
       snapshot already carries (see Siano.Trips.Report). --%>
  <div
    id="report-backdrop"
    data-siano-report-close
    class="fixed inset-0 z-[60] bg-black/70 backdrop-blur-md transition-opacity duration-300"
  >
  </div>

  <aside
    id="report"
    class="pt-safe-lg pb-safe-lg fixed inset-y-0 left-0 z-[65] w-full max-w-md space-y-4 overflow-y-auto border-r border-slate-800 bg-slate-900 px-5 shadow-2xl transition-transform duration-300 ease-in-out"
  >
    <div class="flex items-center justify-between gap-2">
      <h2 class="min-w-0 truncate text-lg font-black tracking-tight">📊 Report &amp; backup</h2>
      <div class="flex shrink-0 items-center gap-2">
        <%!-- Plain browser download (Content-Disposition: attachment) — not a
             LiveView navigation, so it saves the CSV without leaving the board.
             `download` nudges the browser to save rather than display. --%>
        <a
          href={~p"/t/#{@trip.id}/report.csv"}
          download
          class="inline-flex items-center gap-1.5 rounded-full bg-amber-400 px-3 py-1.5 text-sm font-bold text-slate-950 transition hover:bg-amber-300"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="h-4 w-4"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"
            />
          </svg>
          <span>CSV</span>
        </a>
        <button
          type="button"
          data-siano-report-close
          class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-slate-800 text-slate-300 transition hover:bg-slate-700 hover:text-white"
          aria-label="Close report"
        >
          ✕
        </button>
      </div>
    </div>

    <div class="min-h-0">
      <p
          :if={@trip.report.bills == [] or @trip.members == []}
          class="rounded-xl bg-slate-800/40 p-4 text-sm text-slate-400"
        >
          Nothing to report yet — add some travellers and bills, then come back here to
          check the totals and download a backup.
        </p>

        <div :if={@trip.report.bills != [] and @trip.members != []} class="space-y-6">
          <%!-- ── Bills × travellers share matrix ─────────────────────────────── --%>
          <section>
            <h3 class="mb-2 text-xs font-bold uppercase tracking-wide text-amber-300">
              Bills — each traveller's share
            </h3>
            <div class="relative">
            <div
              id="report-bills-scroll"
              phx-hook="StickyHeader"
              class="overflow-x-auto rounded-xl border border-slate-800"
            >
              <table class="min-w-full border-collapse text-right text-xs">
                <thead class="bg-slate-800/70 text-slate-300">
                  <tr>
                    <th class="report-bill-cell sticky left-0 z-10 bg-slate-800/95 px-3 py-2 text-left font-semibold">
                      Bill
                    </th>
                    <th class="whitespace-nowrap px-3 py-2 text-left font-semibold">Payer</th>
                    <th class="px-3 py-2 font-semibold">Total</th>
                    <th
                      :for={m <- @trip.report.members}
                      class="whitespace-nowrap px-3 py-2 font-semibold"
                    >
                      <span style={"color: #{m.color || "#cbd5e1"}"}><%= m.name %></span>
                    </th>
                    <th class="px-3 py-2 font-semibold text-slate-500">Diff</th>
                  </tr>
                </thead>

                <tbody>
                  <tr
                    :for={bill <- @trip.report.bills}
                    class={[
                      "border-t border-slate-800",
                      (bill.complete && "text-slate-200") || "text-slate-500"
                    ]}
                  >
                    <th class="report-bill-cell sticky left-0 z-10 bg-slate-900 px-3 py-2 text-left font-medium">
                      <div class="report-bill-name">
                        <span class="mr-1"><%= bill.emoji %></span><%= bill.name %>
                        <span :if={not bill.complete} class="ml-1 text-[10px] text-slate-600">· draft</span>
                        <span
                          :if={bill.inserted_at}
                          id={"report-time-#{bill.id}"}
                          phx-hook="LocalTime"
                          data-ts={bill.inserted_at}
                          class="block text-[10px] font-normal text-slate-600"
                        >
                        </span>
                      </div>
                    </th>
                    <td class="whitespace-nowrap px-3 py-2 text-left text-slate-400">
                      <%= bill.payer_name || "—" %>
                    </td>
                    <td class="whitespace-nowrap px-3 py-2 font-mono font-semibold text-amber-300">
                      <%= money(bill.amount_cents) %>
                    </td>
                    <td :for={m <- @trip.report.members} class="whitespace-nowrap px-3 py-2 font-mono">
                      <%= if share = report_share(bill, m.id) do %>
                        <%= share %>
                      <% else %>
                        <span class="text-slate-700">·</span>
                      <% end %>
                    </td>
                    <td class={[
                      "whitespace-nowrap px-3 py-2 font-mono",
                      (bill.diff_cents == 0 && "text-slate-700") || "text-rose-400"
                    ]}>
                      <%= (bill.diff_cents == 0 && "—") || money(bill.diff_cents) %>
                    </td>
                  </tr>
                </tbody>

                <%!-- Summary rows reconcile the matrix against the balances the app
                     actually shows: Consumed (each column's shares), Paid (what
                     each traveller fronted), and Net = Paid − Consumed, which is
                     that traveller's balance (green = owed, red = owes). Drafts are
                     excluded, so these use only complete bills. --%>
                <tfoot class="border-t-2 border-slate-700 font-mono text-xs">
                  <tr class="bg-slate-800/40">
                    <th class="report-bill-cell sticky left-0 z-10 bg-slate-800/80 px-3 py-2 text-left font-sans font-semibold text-slate-300">
                      Consumed
                    </th>
                    <td></td>
                    <td class="whitespace-nowrap px-3 py-2 font-semibold text-slate-300">
                      <%= money(@trip.report.consumed_total_cents) %>
                    </td>
                    <td :for={m <- @trip.report.members} class="whitespace-nowrap px-3 py-2 text-slate-300">
                      <%= money(report_total(@trip.report, m.id, :share_cents)) %>
                    </td>
                    <td></td>
                  </tr>
                  <tr class="bg-slate-800/40">
                    <th class="report-bill-cell sticky left-0 z-10 bg-slate-800/80 px-3 py-2 text-left font-sans font-semibold text-slate-300">
                      Paid
                    </th>
                    <td></td>
                    <td class="whitespace-nowrap px-3 py-2 font-semibold text-slate-300">
                      <%= money(@trip.report.grand_total_cents) %>
                    </td>
                    <td :for={m <- @trip.report.members} class="whitespace-nowrap px-3 py-2 text-slate-300">
                      <%= money(report_total(@trip.report, m.id, :paid_cents)) %>
                    </td>
                    <td></td>
                  </tr>
                  <tr class="bg-slate-800/60">
                    <th class="report-bill-cell sticky left-0 z-10 bg-slate-800/90 px-3 py-2 text-left font-sans font-semibold text-slate-200">
                      Net
                    </th>
                    <td></td>
                    <td class={[
                      "whitespace-nowrap px-3 py-2 font-semibold",
                      balance_tone(@trip.report.grand_total_cents - @trip.report.consumed_total_cents)
                    ]}>
                      <%= signed_money(@trip.report.grand_total_cents - @trip.report.consumed_total_cents) %>
                    </td>
                    <td
                      :for={m <- @trip.report.members}
                      class={["whitespace-nowrap px-3 py-2 font-semibold", balance_tone(report_total(@trip.report, m.id, :net_cents))]}
                    >
                      <%= signed_money(report_total(@trip.report, m.id, :net_cents)) %>
                    </td>
                    <td></td>
                  </tr>
                </tfoot>
              </table>
            </div>
            <%!-- First-run coach mark: the table scrolls sideways. Shown once by
                 the Hint hook (see hints.html.heex for the board twin + the shared
                 sketch filter it reuses). pointer-events:none, so the swipe it
                 teaches goes straight through and dismisses it. --%>
            <div
              id="hint-report"
              phx-hook="Hint"
              data-hint-key="report-scroll"
              data-hint-trigger="report"
              data-hint-seconds="6"
              class="siano-hint pointer-events-none absolute inset-x-0 top-0 z-20 flex justify-center pt-14"
              aria-hidden="true"
            >
              <div class="siano-hint-stage">
                <div class="siano-hint-row">
                  <svg viewBox="0 0 14 28" class="siano-hint-chev siano-hint-chev--l"><path d="M11 3 L3 14 L11 25" /></svg>
                  <div class="siano-hint-hand">
                    <svg viewBox="0 0 140 220" class="siano-hint-finger">
                      <use href="#siano-hand" filter="url(#siano-sketch)" />
                    </svg>
                  </div>
                  <svg viewBox="0 0 14 28" class="siano-hint-chev siano-hint-chev--r"><path d="M3 3 L11 14 L3 25" /></svg>
                </div>
                <p class="siano-hint-caption">Swipe sideways to see every share</p>
              </div>
            </div>
            </div>
            <p :if={@trip.report.draft_count > 0} class="mt-1.5 text-[11px] text-slate-500">
              <%= @trip.report.draft_count %> draft <%= (@trip.report.draft_count == 1 && "bill is") || "bills are" %>
              still incomplete (missing a total, payer or people) and don't count toward the totals.
            </p>
          </section>

          <%!-- ── Balances per budget ─────────────────────────────────────────── --%>
          <section :if={@trip.budgets != []}>
            <h3 class="mb-2 text-xs font-bold uppercase tracking-wide text-amber-300">
              Balances — per budget
            </h3>
            <div class="overflow-x-auto rounded-xl border border-slate-800">
              <table class="min-w-full border-collapse text-sm">
                <tbody>
                  <tr :for={b <- @trip.budgets} class="border-b border-slate-800 last:border-0">
                    <td class="px-3 py-2 font-medium text-slate-200"><%= b.name %></td>
                    <td class={["px-3 py-2 text-right font-mono font-semibold", balance_tone(b.balance_cents)]}>
                      <%= balance_label(b.balance_cents) %>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>

          <%!-- ── Suggested settlements ───────────────────────────────────────── --%>
          <section>
            <h3 class="mb-2 text-xs font-bold uppercase tracking-wide text-amber-300">
              Suggested settlements
            </h3>
            <p
              :if={@trip.settlements == []}
              class="rounded-xl bg-slate-800/40 px-3 py-2 text-sm text-emerald-400"
            >
              🎉 Everyone is settled up.
            </p>
            <ul :if={@trip.settlements != []} class="space-y-1.5">
              <li
                :for={s <- @trip.settlements}
                class="flex items-center justify-between gap-2 rounded-xl bg-slate-800/50 px-3 py-2 text-sm"
              >
                <span class="min-w-0 truncate">
                  <span class="font-semibold text-slate-200"><%= s.from %></span>
                  <span class="text-slate-500"> pays </span>
                  <span class="font-semibold text-slate-200"><%= s.to %></span>
                </span>
                <span class="shrink-0 font-mono font-bold text-amber-300"><%= money(s.amount_cents) %></span>
              </li>
            </ul>
          </section>

          <p class="border-t border-slate-800 pt-3 text-[11px] leading-relaxed text-slate-500">
            This is a read-only view — nothing here changes the board. “Consumed” is a
            traveller's share of the bills; “Net” is what they fronted minus what they
            consumed, which is their balance. Tap <b class="text-slate-400">CSV</b> to save
            it all as a spreadsheet-friendly backup.
          </p>
        </div>
      </div>
  </aside>
