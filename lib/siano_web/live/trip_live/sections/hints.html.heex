  <%!-- First-run gesture hints ("coach marks"). Hand-drawn overlays that show
       once — driven by the Hint hook (assets/js/hooks/hints.js) — how to do the
       two non-obvious gestures. Client-only and pointer-events:none: they never
       block the real gesture, and doing it dismisses them. Visibility is a
       :root[data-siano-hint] attribute set by the hook; the look/motion is in
       app.css (search "gesture hints"). This board hint sits over the whole
       screen; the report hint lives inside the report drawer (report.html.heex).

       The shared sketch filter below gives the finger its wobbly hand-drawn
       contour (a subtle turbulence displacement); both hands reference it. --%>
  <svg class="siano-hint-defs" aria-hidden="true" focusable="false">
    <defs>
      <filter id="siano-sketch" x="-30%" y="-30%" width="160%" height="160%">
        <feTurbulence type="fractalNoise" baseFrequency="0.028" numOctaves="2" seed="7" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="2.4" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </defs>
  </svg>

  <div
    id="hint-board"
    phx-hook="Hint"
    data-hint-key="board-drag"
    data-hint-trigger="board"
    data-hint-seconds="6"
    class="siano-hint pointer-events-none fixed inset-0 z-40 grid place-items-center"
    aria-hidden="true"
  >
    <div class="siano-hint-stage">
      <div class="siano-hint-chevs">
        <svg viewBox="0 0 28 14" class="siano-hint-chev"><path d="M3 11 L14 3 L25 11" /></svg>
        <svg viewBox="0 0 28 14" class="siano-hint-chev"><path d="M3 11 L14 3 L25 11" /></svg>
      </div>
      <div class="siano-hint-hand">
        <span class="siano-hint-token">🙂</span>
        <svg
          viewBox="0 0 24 24"
          class="siano-hint-finger"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          filter="url(#siano-sketch)"
        >
          <path d="M23 5.5V20c0 2.2-1.8 4-4 4h-7.3c-1.08 0-2.1-.43-2.85-1.19L1 14.83s1.26-1.23 1.3-1.25c.22-.19.49-.29.79-.29.22 0 .42.06.6.16.04.01 4.31 2.46 4.31 2.46V4c0-.83.67-1.5 1.5-1.5S13 3.17 13 4v7h1V1.5c0-.83.67-1.5 1.5-1.5S17 .67 17 1.5V11h1V2.5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5V11h1V5.5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5z" />
        </svg>
      </div>
      <p class="siano-hint-caption">Drag a traveller up onto the board</p>
    </div>
  </div>
