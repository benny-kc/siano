  <%!-- In-page confirmation dialog (replaces the native confirm() so the app
       never drops out of full-screen). --%>
  <div
    id="confirm-modal"
    phx-hook="Confirm"
    class="hidden fixed inset-0 z-[70] flex items-center justify-center p-6 opacity-0 transition-opacity duration-200"
  >
    <div class="confirm-backdrop absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
    <div class="relative w-full max-w-xs rounded-2xl border border-slate-700 bg-slate-900 p-5 shadow-2xl">
      <p class="confirm-message text-sm leading-relaxed text-slate-200"></p>
      <div class="mt-5 flex justify-end gap-2">
        <button
          type="button"
          class="confirm-no rounded-lg bg-slate-800 px-4 py-2 text-sm font-semibold text-slate-200 transition hover:bg-slate-700"
        >
          No
        </button>
        <button
          type="button"
          class="confirm-yes rounded-lg bg-rose-600 px-4 py-2 text-sm font-bold text-white transition hover:bg-rose-500"
        >
          Yes
        </button>
      </div>
    </div>
  </div>
