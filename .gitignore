# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Persisted trip data (DETS) — runtime state, not source.
/siano_data/

# Ignore package tarball (built via "mix hex.build").
siano-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Beam files.
*.beam
.elixir_ls/

# Dependency lockfile.
mix.lock

# ── Secrets / credentials — never commit anything confidential ──────────────
# Environment files (often hold API keys, DB URLs, tokens)
.env
.env.*
*.env
.envrc
# Phoenix / Elixir secret configs
/config/*.secret.exs
*.secret.exs
secrets.exs
# Generic secret / credential files and folders
*.secret
*.secrets
secrets/
**/secrets/
*credential*
*credentials*
*.token
*.tokens
# Private keys, certificates and keystores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519
id_dsa
id_ecdsa
*_rsa
*_ed25519
# Cloud / service account keys
*service-account*.json
gcp-*.json
aws-credentials
.netrc
